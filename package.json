  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prestart": "node cleanup.js",
    "start": "webpack serve --mode development --config webpack.config.cjs",
    "start:staging": "env-cmd -f .env.staging cross-env NODE_ENV=staging webpack serve --mode development --config webpack.config.cjs",
    "start:prod": "env-cmd -f .env.production webpack serve --mode production --config webpack.config.cjs",
    "build": "webpack --mode production --config webpack.config.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "eject": "react-scripts eject",
    "clean": "rm -rf dist/*",
    "build:clean": "npm run clean && npm run build",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "check-format": "prettier --check \"**/*.{js,jsx,json,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoftAssist/softassist_ui.git"
